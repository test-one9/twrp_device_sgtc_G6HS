/cache          ext4    nosuid,nodev,barrier=1                                                         wait,check
/boot           emmc    defaults                                                                       defaults
/recovery       emmc    defaults                                                                       defaults
/external_sd    vfat    nosuid,nodev                                                                   wait
/usbotg         vfat    nosuid,nodev                                                                   wait
